# MiniMax API Configuration
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here

# Runway API Configuration
RUNWAY_API_KEY=your_runway_api_key_here

# Local Kokoro narration (no external TTS API key or quota)
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.0

# Free Media Search API Configuration
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# Content / Voice Language
# Supported: en (English), ar (Arabic), fr (French), de (German)
DEFAULT_LANGUAGE=en

# Video Generation Configuration
MAX_VIDEO_DURATION=120
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_QUALITY=1080p
DEFAULT_PROVIDER=minimax

# Audio Configuration
BACKGROUND_MUSIC_ENABLED=true
VOICE_OVER_VOLUME=0.8
BACKGROUND_MUSIC_VOLUME=0.3

# Processing Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log
LOGS_DIR=logs
TEMP_DIR=temp
SEGMENTS_DIR=segments
DOWNLOADS_DIR=downloads
AUDIO_DIR=audio
OUTPUT_DIR=output

# Provider Limits
MINIMAX_MAX_DURATION=60
RUNWAY_MAX_DURATION=60

# Polling Configuration
POLLING_INTERVAL_SECONDS=5
POLLING_TIMEOUT_SECONDS=600
POLLING_MAX_RETRIES=120

# Connection Configuration
REQUEST_TIMEOUT_SECONDS=30
CONNECTION_TIMEOUT_SECONDS=10
